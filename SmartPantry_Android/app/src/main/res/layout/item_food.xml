<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/card_white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:padding="0dp">

        <!-- 원형 아이콘 배경 -->
        <TextView
            android:id="@+id/tv_food_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_circle_green"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 식재료 이름 -->
        <TextView
            android:id="@+id/tv_food_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="식재료명"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:layout_constraintStart_toEndOf="@id/tv_food_icon"
            app:layout_constraintEnd_toStartOf="@id/tv_badge"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tv_expiry_date" />

        <!-- 유통기한 -->
        <TextView
            android:id="@+id/tv_expiry_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="유통기한: 2026-01-01"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            app:layout_constraintStart_toEndOf="@id/tv_food_icon"
            app:layout_constraintEnd_toStartOf="@id/tv_badge"
            app:layout_constraintTop_toBottomOf="@id/tv_food_name"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- D-Day 뱃지 -->
        <TextView
            android:id="@+id/tv_badge"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="12dp"
            android:minWidth="44dp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="D-3"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_green"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
